# ─── Neon Postgres ────────────────────────────────────────────────────────────
# POOLED URL  → host contains "-pooler"; used by the API and BullMQ worker at runtime.
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# DIRECT URL  → no "-pooler"; used ONLY by the migration script / DDL.
DIRECT_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ─── Redis (BullMQ) ───────────────────────────────────────────────────────────
# Local dev:  docker compose up -d redis  (see docker-compose.yml)
# Production: Upstash Redis → use rediss:// (TLS) URL
REDIS_URL=redis://localhost:6379

# ─── AI Provider ──────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Swapping to OpenAI requires only changing the two lines below + AI_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o

LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# ─── RAG tuning ───────────────────────────────────────────────────────────────
MIN_SIMILARITY=0.5
HYBRID_RRF_K=60

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=replace-with-32+random-chars

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# ─── Ingestion ────────────────────────────────────────────────────────────────
MAX_CHUNK_CHARS=2000
CHUNK_OVERLAP=300
